import LeanCloudRuntime
import ChaosFixture.PoolWorkload
import ChaosFixture.StressWorkload

open LeanCloud LeanCloudRuntime LeanCloudTests

def program : CloudProgram PoolWorkload.Input Nat := {
  name := "generated"
  version := "v1"
  run := PoolWorkload.workflow
}

def stressProgram : CloudProgram StressWorkload.Input Nat := {
  name := "stress", version := "v1", run := StressWorkload.workflow }

/-- Test-only inspection through the production S3 reader. It neither executes
a workflow nor opens scheduler/inbox storage, and is not exposed by HTTP. -/
private def readRecords (path : String) : IO UInt32 := do
  let config ← Config.load path
  let keys : Array (String × Array String) ← IO.ofExcept
    (Lean.Json.parse (← (← IO.getStdin).getLine) >>= Lean.fromJson?)
  let saved ← keys.mapM fun (run, keys) => do
    let records ← keys.mapM fun key => do
      let some value ← S3.readJson config.blobs run key
        | throw (IO.userError s!"Missing confirmed record: {run}/{key}")
      return (key, value)
    return (run, records)
  IO.println (Lean.toJson saved).compress
  return 0

def main (args : List String) : IO UInt32 :=
  match args with
  | ["read-records", path] => readRecords path
  | _ => Application.main ⟨#[program.register #[], stressProgram.register #[]]⟩ args
