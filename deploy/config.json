{
  "worker": {
    "interpreterFuel": 100000
  },
  "scheduler": {
    "database": "/data/scheduler.sqlite",
    "assignmentMs": 30000
  },
  "blobs": {
    "endpoint": "http://blobs:8333",
    "bucket": "lean-cloud",
    "region": "us-east-1",
    "provider": "s3",
    "authentication": {
      "kind": "keys",
      "accessKey": "local-cloud",
      "secretKey": "local-cloud-secret"
    }
  },
  "mailboxes": {
    "scheduler": {
      "host": "scheduler-mailbox",
      "port": 8080,
      "token": "local-cloud"
    },
    "workers": [
      {
        "worker": "worker1",
        "endpoint": {
          "host": "worker1-mailbox",
          "port": 8080,
          "token": "local-cloud"
        },
        "cpus": 1,
        "memoryMiB": null
      },
      {
        "worker": "worker2",
        "endpoint": {
          "host": "worker2-mailbox",
          "port": 8080,
          "token": "local-cloud"
        },
        "cpus": 1,
        "memoryMiB": null
      },
      {
        "worker": "worker3",
        "endpoint": {
          "host": "worker3-mailbox",
          "port": 8080,
          "token": "local-cloud"
        },
        "cpus": 1,
        "memoryMiB": null
      }
    ]
  },
  "formatVersion": 1,
  "client": null
}
